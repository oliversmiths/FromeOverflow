# macOS
.DS_Store

# Node — this project has no dependencies, but just in case
node_modules/
npm-debug.log*

# Local env / editor scratch
.env
*.local

# DB backups from manual prunes (see scripts/audit-ids.js workflow)
*.db.bak*
docs/_*.html
docs/_*.json

# The database lives on the orphan `db` branch, not on main — it is rewritten
# every poll, and keeping its history here grew .git without bound. Fetch it with:
#   git fetch origin db && git show origin/db:overflows.db > overflows.db
overflows.db

# NOTE: docs/data.json IS committed on purpose — the Action commits each reading
# back to main, and archive/*.sql.gz is the permanent weekly record.
